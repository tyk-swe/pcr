{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:packetcraftr:segmentation:v1",
  "title": "PacketcraftR TCP segmentation matrix v1",
  "type": "object",
  "required": [
    "schema",
    "label",
    "cells"
  ],
  "properties": {
    "schema": {
      "const": "packetcraftr.segmentation/v1"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "destination",
          "port",
          "expect"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "expect": {
            "enum": [
              "reachable",
              "refused",
              "silent"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
