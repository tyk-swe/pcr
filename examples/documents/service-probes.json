  "probes": [
    {
      "id": "ssh-banner",
      "transport": "tcp",
      "intensity": 1,
      "request": {
        "type": "banner"
      },
      "metadata": {
        "source": "PacketcraftR project-authored fixture",
        "reference": "https://www.rfc-editor.org/rfc/rfc4253#section-4.2",
        "license": "AGPL-3.0-only",
        "maintainer": "tyk-swe",
        "updated": "2026-10-09"
      },
      "read_only_review": {
        "reviewed_by": "tyk-swe",
        "reviewed": "2026-10-09",
        "statement": "Receives the server identification only; transmits no SSH bytes, credentials, or authentication attempt."
      }
    },
    {
      "id": "http-head",
      "transport": "tcp",
      "intensity": 2,
      "request": {
        "type": "http_head"
      },
      "metadata": {
        "source": "PacketcraftR project-authored fixture",
        "reference": "https://www.rfc-editor.org/rfc/rfc9110#section-9.3.2",
        "license": "AGPL-3.0-only",
        "maintainer": "tyk-swe",
        "updated": "2026-10-09"
      },
      "read_only_review": {
        "reviewed_by": "tyk-swe",
        "reviewed": "2026-10-09",
        "statement": "Sends only HEAD / HTTP/1.0 with no credentials, body, or mutable method; does not follow redirects or authenticate."
      }
    },
