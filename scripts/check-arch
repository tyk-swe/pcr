#!/usr/bin/env bash
# Copyright (C) 2026 tyk-swe
# SPDX-License-Identifier: AGPL-3.0-only

# Enforces semantic dependency boundaries without duplicating Cargo's topology.

set -euo pipefail

cd "$(dirname "$0")/.."

metadata_file="$(mktemp)"
trap 'rm -f "$metadata_file"' EXIT
cargo metadata --locked --format-version 1 > "$metadata_file"

python3 - "$metadata_file" <<'PY'
import json
import pathlib
import sys

metadata = json.loads(pathlib.Path(sys.argv[1]).read_text())
workspace_ids = set(metadata["workspace_members"])
workspace_packages = {
    package["id"]: package for package in metadata["packages"] if package["id"] in workspace_ids
}
ids_by_name = {package["name"]: package_id for package_id, package in workspace_packages.items()}
graph = {
    package_id: {
        dependency["path"]
        for dependency in package["dependencies"]
        if dependency["kind"] is None
        and dependency["source"] is None
        and dependency.get("path") is not None
    }
    for package_id, package in workspace_packages.items()
}

# Cargo metadata represents dependencies by package identity elsewhere in its
# resolve graph, but normal local dependency paths are sufficient here and do
# not rely on package names or a checked-in edge registry.
ids_by_manifest_dir = {
    str(pathlib.Path(package["manifest_path"]).parent.resolve()): package_id
    for package_id, package in workspace_packages.items()
}
graph = {
    package_id: {
        ids_by_manifest_dir[str(pathlib.Path(path).resolve())]
        for path in dependency_paths
        if str(pathlib.Path(path).resolve()) in ids_by_manifest_dir
    }
    for package_id, dependency_paths in graph.items()
}

errors = []

visiting = []
visited = set()


def visit(package_id):
    if package_id in visiting:
        cycle = visiting[visiting.index(package_id):] + [package_id]
        names = [workspace_packages[item]["name"] for item in cycle]
        errors.append(f"normal workspace dependency cycle: {' -> '.join(names)}")
        return
    if package_id in visited:
        return
    visiting.append(package_id)
    for dependency_id in graph[package_id]:
        visit(dependency_id)
    visiting.pop()
    visited.add(package_id)


for package_id in graph:
    visit(package_id)

analysis_id = ids_by_name.get("packetcraftr-analysis")
if analysis_id is None:
    errors.append("offline boundary owner packetcraftr-analysis is missing")
else:
    reachable = set()
    pending = list(graph[analysis_id])
    while pending:
        package_id = pending.pop()
        if package_id in reachable:
            continue
        reachable.add(package_id)
        pending.extend(graph[package_id])

    # These packages own policy-gated live clients and native network access.
    # If that ownership moves, update this focused boundary check alongside the
    # move; ordinary package or dependency changes need no registry update.
    live_owners = {
        package_id
        for name in ("packetcraftr-client", "packetcraftr-net")
        if (package_id := ids_by_name.get(name)) is not None
    }
    reached_live = sorted(
        workspace_packages[package_id]["name"] for package_id in reachable & live_owners
    )
    if reached_live:
        errors.append(
            "packetcraftr-analysis has a normal dependency path to live capability owner(s): "
            + ", ".join(reached_live)
        )

if errors:
    for error in errors:
        print(f"workspace architecture: {error}", file=sys.stderr)
    raise SystemExit(1)

print(
    "workspace boundaries: Cargo metadata graph is acyclic and "
    "packetcraftr-analysis cannot reach live capability owners"
)
PY
