{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "packetcraftr.scanner-corpus/v1",
  "title": "Independent scanner ground-truth inventory",
  "type": "object",
  "required": ["schema", "dataset_version", "families", "transports", "fixture_addresses", "request", "nmap", "scenarios", "native_connect_scenarios", "traceroute_scenarios", "identification_scenarios", "provenance", "tcp_diagnostic_scenarios"],
  "additionalProperties": false,
  "properties": {
    "tcp_diagnostic_scenarios": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "port",
          "families",
          "provision",
          "request",
          "variants",
          "expected"
        ],
        "properties": {
          "id": {
            "enum": [
              "reset-zero",
              "reset-positive",
              "silent",
              "prohibited",
              "unexpected",
              "reset-and-prohibited",
              "port-unreachable",
              "time-exceeded"
            ]
          },
          "port": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 1007
          },
          "families": {
            "const": [
              "ipv4",
              "ipv6"
            ]
          },
          "provision": {
            "const": "independent_tcp_reply_scripts"
          },
          "request": {
            "const": {
              "attempts": 1,
              "timeout_ms": 40,
              "max_duration_ms": 10000,
              "max_probes": 8,
              "max_evidence_bytes": 65536,
              "windows": [
                1,
                4
              ]
            }
          },
          "variants": {
            "const": [
              "ordinary",
              "wrong_identity_and_checksum",
              "reordered",
              "duplicate",
              "late"
            ]
          },
          "expected": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "flags",
                "status",
                "classification",
                "reply",
                "tcp_window",
                "state",
                "rule",
                "partitions"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "ack",
                    "window",
                    "fin",
                    "null",
                    "xmas",
                    "maimon",
                    "custom"
                  ]
                },
                "flags": {
                  "enum": [
                    0,
                    1,
                    16,
                    17,
                    41
                  ]
                },
                "status": {
                  "enum": [
                    "response",
                    "timeout"
                  ]
                },
                "classification": {
                  "enum": [
                    "closed",
                    "filtered",
                    "unreachable",
                    "unknown",
                    "timeout"
                  ]
                },
                "reply": {
                  "enum": [
                    null,
                    "tcp_reset",
                    "tcp_syn_ack",
                    "tcp_other",
                    "icmp_administratively_prohibited",
                    "icmp_destination_unreachable",
                    "icmp_port_unreachable",
                    "icmp_time_exceeded"
                  ]
                },
                "tcp_window": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 65535
                },
                "state": {
                  "enum": [
                    "open",
                    "closed",
                    "filtered",
                    "open_or_filtered",
                    "unfiltered",
                    "unknown"
                  ]
                },
                "rule": {
                  "type": "string",
                  "minLength": 1
                },
                "partitions": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "supporting",
                    "conflicting",
                    "unanswered",
                    "failed"
                  ],
                  "properties": {
                    "supporting": {
                      "const": [
                        1
                      ]
                    },
                    "conflicting": {
                      "const": []
                    },
                    "unanswered": {
                      "const": []
                    },
                    "failed": {
                      "const": []
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "identification_scenarios": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/identificationScenario"}},
    "inference_scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/inferenceScenario"}
    },
    "schema": {"const": "packetcraftr.scanner-corpus/v1"},
    "dataset_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "families": {"const": ["ipv4", "ipv6"]},
    "transports": {"const": ["tcp", "udp", "icmp"]},
    "fixture_addresses": {
      "type": "object",
      "required": ["ipv4", "ipv6"],
      "additionalProperties": false,
      "properties": {"ipv4": {"$ref": "#/$defs/addresses"}, "ipv6": {"$ref": "#/$defs/addresses"}}
    },
    "request": {
      "type": "object",
      "required": ["attempts", "ports", "timeout_ms", "max_duration_ms", "max_probes", "max_evidence_bytes", "windows"],
      "additionalProperties": false,
      "properties": {
        "attempts": {"const": 1},
        "ports": {"const": [443]},
        "timeout_ms": {"const": 20},
        "max_duration_ms": {"const": 2000},
        "max_probes": {"const": 1},
        "max_evidence_bytes": {"const": 65536},
        "windows": {"const": [1, 2]}
      }
    },
    "nmap": {
      "type": "object",
      "required": ["version", "acquisition", "connect_arguments", "limitations"],
      "additionalProperties": false,
      "properties": {
        "version": {"const": "7.991"},
        "acquisition": {"$ref": "#/$defs/text"},
        "connect_arguments": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "limitations": {"$ref": "#/$defs/text"}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "condition", "provision", "expected", "divergence"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["responsive", "closed", "blocked", "silent", "malformed", "unrelated"]},
          "condition": {"$ref": "#/$defs/text"},
          "provision": {"$ref": "#/$defs/text"},
          "expected": {
            "type": "object",
            "required": ["attempt_classification", "status", "attributed_response"],
            "additionalProperties": false,
            "properties": {
              "attempt_classification": {"enum": ["open", "closed", "filtered", "timeout"]},
              "status": {"enum": ["response", "timeout"]},
              "attributed_response": {"type": "boolean"}
            }
          },
          "expected_by_transport": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "icmp": {
                "type": "object",
                "required": ["attempt_classification", "status", "attributed_response"],
                "additionalProperties": false,
                "properties": {
                  "attempt_classification": {"const": "unreachable"},
                  "status": {"const": "response"},
                  "attributed_response": {"const": true}
                }
              }
            }
          },
          "divergence": {"$ref": "#/$defs/text"}
        }
      }
    },
    "native_connect_scenarios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "condition", "expected_outcome", "expected_classification", "nmap_expected", "divergence"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["connect-responsive", "connect-closed"]},
          "condition": {"$ref": "#/$defs/text"},
          "expected_outcome": {"enum": ["connected", "refused"]},
          "expected_classification": {"enum": ["open", "closed"]},
          "nmap_expected": {"enum": ["open", "closed"]},
          "divergence": {"$ref": "#/$defs/text"}
        }
      }
    },
    "traceroute_scenarios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "condition", "expected_termination", "expected_status", "expected_attributed_response", "divergence"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["responsive", "silent"]},
          "condition": {"$ref": "#/$defs/text"},
          "expected_termination": {"enum": ["destination_reached", "timeout"]},
          "expected_status": {"enum": ["response", "timeout"]},
          "expected_attributed_response": {"type": "boolean"},
          "divergence": {"$ref": "#/$defs/text"}
        }
      }
    },
    "trace_path_scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/tracePathScenario"}
    },
    "target_planning_scenarios": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "type": "object",
          "required": [
            "id",
            "condition",
            "include",
            "expected_addresses",
            "expected_resolution_performed",
            "divergence"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "numeric-source-equivalence"
            },
            "condition": {
              "$ref": "#/$defs/text"
            },
            "include": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "expected_addresses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "expected_resolution_performed": {
              "type": "boolean"
            },
            "divergence": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "condition",
            "include",
            "exclude",
            "expected_addresses",
            "family_include",
            "family",
            "expected_family_addresses",
            "divergence"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "numeric-narrowing"
            },
            "condition": {
              "$ref": "#/$defs/text"
            },
            "include": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "exclude": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "expected_addresses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "family_include": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "family": {
              "enum": [
                "ipv4",
                "ipv6"
              ]
            },
            "expected_family_addresses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "divergence": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "condition",
            "expected",
            "divergence"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "manifest-boundaries"
            },
            "condition": {
              "$ref": "#/$defs/text"
            },
            "expected": {
              "type": "object",
              "required": [
                "input_errors_before_active_work",
                "duplicate_diagnostic",
                "source_position_retained",
                "unique_stdin_consumer"
              ],
              "additionalProperties": false,
              "properties": {
                "input_errors_before_active_work": {
                  "type": "boolean"
                },
                "duplicate_diagnostic": {
                  "$ref": "#/$defs/text"
                },
                "source_position_retained": {
                  "type": "boolean"
                },
                "unique_stdin_consumer": {
                  "type": "boolean"
                }
              }
            },
            "divergence": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "condition",
            "expected",
            "divergence"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "scoped-host-local"
            },
            "condition": {
              "$ref": "#/$defs/text"
            },
            "expected": {
              "type": "object",
              "required": [
                "selected_targets",
                "origins",
                "scope_interface_retained",
                "connect_outcome",
                "connect_classification",
                "raw",
                "portable"
              ],
              "additionalProperties": false,
              "properties": {
                "selected_targets": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "origins": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "scope_interface_retained": {
                  "type": "boolean"
                },
                "connect_outcome": {
                  "$ref": "#/$defs/text"
                },
                "connect_classification": {
                  "$ref": "#/$defs/text"
                },
                "raw": {
                  "$ref": "#/$defs/text"
                },
                "portable": {
                  "$ref": "#/$defs/text"
                }
              }
            },
            "divergence": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "condition",
            "expected",
            "divergence"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "scoped-isolated-links"
            },
            "condition": {
              "$ref": "#/$defs/text"
            },
            "expected": {
              "type": "object",
              "required": [
                "selected_targets",
                "alias_origins",
                "correct_zone_connect",
                "other_zone_connect",
                "raw_open",
                "raw_closed",
                "scope_interface_retained"
              ],
              "additionalProperties": false,
              "properties": {
                "selected_targets": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "alias_origins": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "correct_zone_connect": {
                  "$ref": "#/$defs/text"
                },
                "other_zone_connect": {
                  "$ref": "#/$defs/text"
                },
                "raw_open": {
                  "$ref": "#/$defs/text"
                },
                "raw_closed": {
                  "$ref": "#/$defs/text"
                },
                "scope_interface_retained": {
                  "type": "boolean"
                }
              }
            },
            "divergence": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ],
      "items": false
    },
    "discovery_scenarios": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "condition",
          "provision",
          "families",
          "expected",
          "measurement_scope"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "discovery-responsive",
              "discovery-closed-but-responsive",
              "discovery-silent",
              "discovery-blocked",
              "discovery-routed",
              "discovery-shared-link-address"
            ]
          },
          "condition": {
            "$ref": "#/$defs/text"
          },
          "provision": {
            "const": "injected_provider_and_controlled_native"
          },
          "families": {
            "const": [
              "ipv4",
              "ipv6"
            ]
          },
          "expected": {
            "type": "object",
            "required": [
              "state",
              "reply_by_probe",
              "basis",
              "responded_reasons"
            ],
            "additionalProperties": false,
            "properties": {
              "state": {
                "enum": [
                  "responded",
                  "no_response"
                ]
              },
              "reply_by_probe": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "icmp": {
                    "enum": [
                      null,
                      "icmp_echo_reply",
                      "tcp_syn_ack",
                      "udp_payload",
                      "tcp_reset",
                      "icmp_port_unreachable",
                      "icmp_administratively_prohibited",
                      "icmp_destination_unreachable",
                      "neighbor_reply"
                    ]
                  },
                  "tcp": {
                    "enum": [
                      null,
                      "icmp_echo_reply",
                      "tcp_syn_ack",
                      "udp_payload",
                      "tcp_reset",
                      "icmp_port_unreachable",
                      "icmp_administratively_prohibited",
                      "icmp_destination_unreachable",
                      "neighbor_reply"
                    ]
                  },
                  "udp": {
                    "enum": [
                      null,
                      "icmp_echo_reply",
                      "tcp_syn_ack",
                      "udp_payload",
                      "tcp_reset",
                      "icmp_port_unreachable",
                      "icmp_administratively_prohibited",
                      "icmp_destination_unreachable",
                      "neighbor_reply"
                    ]
                  },
                  "neighbor": {
                    "enum": [
                      null,
                      "icmp_echo_reply",
                      "tcp_syn_ack",
                      "udp_payload",
                      "tcp_reset",
                      "icmp_port_unreachable",
                      "icmp_administratively_prohibited",
                      "icmp_destination_unreachable",
                      "neighbor_reply"
                    ]
                  }
                }
              },
              "basis": {
                "enum": [
                  "direct",
                  "possible_proxy"
                ]
              },
              "responded_reasons": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          },
          "measurement_scope": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "adaptive_scheduling_scenarios": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "condition", "provision", "families", "expected", "measurement_scope"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["adaptive-responsive", "adaptive-selective-retry", "adaptive-rate-limited-control", "adaptive-fair-hosts", "adaptive-host-deadline", "adaptive-window-loss", "adaptive-connect-cleanup", "adaptive-plan-boundary"]},
          "condition": {"$ref": "#/$defs/text"},
          "provision": {"enum": ["injected_provider_virtual_clock", "injected_provider_isolated_process"]},
          "families": {"const": ["ipv4", "ipv6"]},
          "expected": {"$ref": "#/$defs/text"},
          "measurement_scope": {"$ref": "#/$defs/text"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "retrieved", "transforms", "license", "license_rationale", "maintainer", "refresh", "coverage"],
      "additionalProperties": false,
      "properties": {
        "source": {"$ref": "#/$defs/text"},
        "retrieved": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "transforms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "license": {"const": "AGPL-3.0-only"},
        "license_rationale": {"$ref": "#/$defs/text"},
        "maintainer": {"$ref": "#/$defs/text"},
        "refresh": {"$ref": "#/$defs/text"},
        "coverage": {"$ref": "#/$defs/text"}
      }
    }
  },
  "$defs": {
    "identificationScenario": {
      "type": "object",
      "required": [
        "id",
        "condition",
        "provision",
        "families",
        "transport",
        "expected",
        "measurement_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^identification-[a-z-]+$"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "provision": {
          "enum": [
            "protocol_fixture",
            "loopback_or_recording_provider"
          ]
        },
        "families": {
          "const": [
            "ipv4",
            "ipv6"
          ]
        },
        "transport": {
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "measurement_scope": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "object",
          "required": [
            "outcome",
            "product",
            "version",
            "confidence"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "enum": [
                "matched",
                "unknown",
                "ambiguous",
                "malformed",
                "truncated",
                "excluded"
              ]
            },
            "product": {
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "enum": [
                "claim",
                "protocol",
                null
              ]
            }
          }
        }
      }
    },

    "inferenceScenario": {
      "type": "object",
      "required": ["id", "condition", "provision", "families", "request", "endpoints", "divergence"],
      "additionalProperties": false,
      "properties": {
        "id": {"enum": ["mixed-same-port", "silent-udp", "contradictory-udp"]},
        "condition": {"$ref": "#/$defs/text"},
        "provision": {"const": "injected_endpoint_attempt_scripts"},
        "families": {"const": ["ipv4", "ipv6"]},
        "request": {"$ref": "#/$defs/inferenceRequest"},
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/inferenceEndpoint"}
        },
        "divergence": {"$ref": "#/$defs/text"}
      }
    },
    "inferenceRequest": {
      "type": "object",
      "required": ["attempts", "max_in_flight", "timeout_ms", "max_duration_ms", "max_probes", "max_evidence_bytes"],
      "additionalProperties": false,
      "properties": {
        "attempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "max_in_flight": {"type": "integer", "minimum": 1, "maximum": 2},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_duration_ms": {"type": "integer", "minimum": 100, "maximum": 60000},
        "max_probes": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_evidence_bytes": {"type": "integer", "minimum": 64, "maximum": 1048576}
      }
    },
    "inferenceEndpoint": {
      "type": "object",
      "required": ["transport", "port", "script", "expected"],
      "additionalProperties": false,
      "properties": {
        "transport": {"enum": ["tcp", "udp"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "script": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"enum": ["direct_reply", "refusal", "silence"]}
        },
        "expected": {"$ref": "#/$defs/inferenceExpectation"}
      }
    },
    "inferenceExpectation": {
      "type": "object",
      "required": ["attempts", "state", "rule", "partitions"],
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/inferenceAttempt"}
        },
        "state": {"enum": ["open", "closed", "filtered", "open_or_filtered", "unknown"]},
        "rule": {
          "enum": [
            "tcp_syn.syn_ack",
            "tcp_syn.reset",
            "tcp_syn.icmp_unreachable",
            "tcp_syn.time_exceeded",
            "tcp_syn.unclassified_reply",
            "tcp_syn.silence",
            "udp.reply",
            "udp.port_unreachable",
            "udp.icmp_unreachable",
            "udp.time_exceeded",
            "udp.unclassified_reply",
            "udp.silence"
          ]
        },
        "partitions": {"$ref": "#/$defs/inferencePartitions"}
      }
    },
    "inferenceAttempt": {
      "type": "object",
      "required": ["ordinal", "status", "classification", "reply"],
      "additionalProperties": false,
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 3},
        "status": {"enum": ["response", "timeout"]},
        "classification": {"enum": ["open", "closed", "filtered", "unknown", "timeout"]},
        "reply": {"enum": ["tcp_syn_ack", "udp_payload", "icmp_port_unreachable", null]}
      }
    },
    "inferencePartitions": {
      "type": "object",
      "required": ["supporting", "conflicting", "unanswered", "failed"],
      "additionalProperties": false,
      "properties": {
        "supporting": {"$ref": "#/$defs/inferenceOrdinals"},
        "conflicting": {"$ref": "#/$defs/inferenceOrdinals"},
        "unanswered": {"$ref": "#/$defs/inferenceOrdinals"},
        "failed": {"$ref": "#/$defs/inferenceOrdinals"}
      }
    },
    "inferenceOrdinals": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "integer", "minimum": 1, "maximum": 3}
    },
    "tracePathScenario": {
      "type": "object",
      "required": ["id", "condition", "targets", "paths", "expected_termination", "expected_probes_without_reuse", "expected_probes_with_reuse", "expected_reused_hops", "divergence"],
      "additionalProperties": false,
      "properties": {
        "id": {"enum": ["shared-path", "divergent-paths", "silent-hop"]},
        "condition": {"$ref": "#/$defs/text"},
        "targets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        },
        "paths": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/tracePath"}
        },
        "expected_termination": {"enum": ["destination_reached", "unreachable", "maximum_hops", "timeout"]},
        "expected_probes_without_reuse": {"type": "integer", "minimum": 1, "maximum": 4096},
        "expected_probes_with_reuse": {"type": "integer", "minimum": 1, "maximum": 4096},
        "expected_reused_hops": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/reusedHops"}
        },
        "divergence": {"$ref": "#/$defs/text"}
      }
    },
    "tracePath": {
      "type": "object",
      "required": ["target", "hops", "arrival"],
      "additionalProperties": false,
      "properties": {
        "target": {"type": "string", "minLength": 1, "maxLength": 64},
        "hops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"anyOf": [
            {"type": "string", "minLength": 1, "maxLength": 64},
            {"type": "null"}
          ]}
        },
        "arrival": {"enum": ["reply", "unreachable", "silent"]}
      }
    },
    "reusedHops": {
      "type": "object",
      "required": ["target", "source", "hop_limits"],
      "additionalProperties": false,
      "properties": {
        "target": {"type": "string", "minLength": 1, "maxLength": 64},
        "source": {"type": "string", "minLength": 1, "maxLength": 64},
        "hop_limits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "integer", "minimum": 1, "maximum": 255}
        }
      }
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "addresses": {
      "type": "object",
      "required": ["source", "destination", "router"],
      "additionalProperties": false,
      "properties": {"source": {"type": "string"}, "destination": {"type": "string"}, "router": {"type": "string"}}
    }
  }
}
