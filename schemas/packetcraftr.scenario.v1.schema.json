{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:packetcraftr:scenario:v1",
  "title": "PacketcraftR synthetic scenario v1",
  "type": "object",
  "required": [
    "schema",
    "label",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "packetcraftr.scenario/v1"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "label",
          "packet"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "packet": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "delay_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "tags": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
