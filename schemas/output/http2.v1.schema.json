        "max_concurrent_streams": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "initial_window_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "max_frame_size": {
          "type": "integer",
          "minimum": 16384,
          "maximum": 16777215
        },
        "max_header_list_size": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "http2Priority": {
      "type": "object",
      "required": [
