{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:packetcraftr:output:traceroute:v1",
  "title": "PacketcraftR traceroute output payload v1",
  "description": "Success payload contract for the traceroute command. The stable envelope is validated separately.",
  "allOf": [
    {
      "type": "object",
      "required": [
        "command",
        "payload_schema"
      ],
      "properties": {
        "command": {
          "const": "traceroute"
        },
        "payload_schema": {
          "const": "packetcraftr.output.traceroute/v1"
        }
      }
    },
    {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/aggregateSuccessEnvelope"
            },
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/tracerouteSuccess"
                }
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/streamSuccessEnvelope"
            },
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/tracerouteStreamSuccess"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "$defs": {
    "multipathChange": {
      "type": "object",
      "required": [
        "flow_id",
        "hop_limit",
        "previous_sweep",
        "sweep",
        "before",
        "after",
        "evidence"
      ],
      "properties": {
        "flow_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "hop_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "previous_sweep": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "sweep": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "before": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
        },
        "after": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": true
    },
    "multipathCompletion": {
      "type": "object",
      "required": [
        "flow_id",
        "sweep",
        "completion",
        "last_hop"
      ],
      "properties": {
        "flow_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "sweep": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "completion": {
          "enum": [
            "destination_reached",
            "unreachable",
            "maximum_hops",
            "timeout"
          ]
        },
        "last_hop": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      },
      "additionalProperties": true
    },
    "multipathEdge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "evidence"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/multipathNodeKey"
        },
        "to": {
          "$ref": "#/$defs/multipathNodeKey"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": true
    },
    "multipathFlow": {
      "type": "object",
      "required": [
        "id",
        "destination",
        "strategy",
        "source",
        "source_port",
        "destination_port",
        "icmp_identifier",
        "ipv6_flow_label"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "destination": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
        },
        "strategy": {
          "enum": [
            "udp",
            "tcp",
            "icmp"
          ]
        },
        "source": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
        },
        "source_port": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "destination_port": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "icmp_identifier": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ]
        },
        "ipv6_flow_label": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048575
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "multipathFlowSummary": {
      "type": "object",
      "required": [
        "flow_id",
        "probes_sent",
        "answered_probes",
        "unanswered_probes",
        "ambiguous_probes",
        "sweeps_reached",
        "destination_rtt"
      ],
      "properties": {
        "probes_sent": {
          "type": "integer",
          "minimum": 0
        },
        "answered_probes": {
          "type": "integer",
          "minimum": 0
        },
        "unanswered_probes": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous_probes": {
          "type": "integer",
          "minimum": 0
        },
        "sweeps_reached": {
          "type": "integer",
          "minimum": 0
        },
        "flow_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "destination_rtt": {
          "anyOf": [
            {
              "$ref": "#/$defs/multipathRtt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "multipathNode": {
      "type": "object",
      "required": [
        "hop_limit",
        "responder",
        "rtt"
      ],
      "properties": {
        "hop_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "responder": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
        },
        "rtt": {
          "$ref": "#/$defs/multipathRtt"
        }
      },
      "additionalProperties": true
    },
    "multipathNodeKey": {
      "type": "object",
      "required": [
        "hop_limit",
        "responder"
      ],
      "properties": {
        "hop_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "responder": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
        }
      },
      "additionalProperties": true
    },
    "multipathProbe": {
      "type": "object",
      "required": [
        "sequence",
        "flow_id",
        "sweep",
        "hop_limit",
        "sent_at",
        "replies_seen",
        "ambiguous",
        "incomplete",
        "replies"
      ],
      "properties": {
        "sequence": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "flow_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "sweep": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "hop_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "sent_at": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/timestamp"
        },
        "replies_seen": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "boolean"
        },
        "incomplete": {
          "type": "boolean"
        },
        "replies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/multipathReply"
          }
        }
      },
      "additionalProperties": true
    },
    "multipathReply": {
      "type": "object",
      "required": [
        "responder",
        "kind",
        "latency",
        "frame"
      ],
      "properties": {
        "responder": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
        },
        "kind": {
          "enum": [
            "intermediate",
            "destination_reached",
            "unreachable"
          ]
        },
        "latency": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/duration"
        },
        "frame": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/frame"
        }
      },
      "additionalProperties": true
    },
    "multipathResult": {
      "type": "object",
      "required": [
        "mode",
        "target",
        "resolved_addresses",
        "destination",
        "strategy",
        "summary",
        "flows",
        "completions",
        "topology",
        "probes",
        "unmatched",
        "flow_summaries"
      ],
      "properties": {
        "mode": {
          "const": "multipath"
        },
        "target": {
          "type": "string"
        },
        "resolved_addresses": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
          },
          "minItems": 1
        },
        "destination": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
        },
        "strategy": {
          "enum": [
            "udp",
            "tcp",
            "icmp"
          ]
        },
        "summary": {
          "$ref": "#/$defs/multipathSummary"
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/multipathFlow"
          }
        },
        "completions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/multipathCompletion"
          }
        },
        "topology": {
          "$ref": "#/$defs/multipathTopology"
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/multipathProbe"
          }
        },
        "unmatched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/multipathUnmatched"
          }
        },
        "flow_summaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/multipathFlowSummary"
          }
        }
      },
      "additionalProperties": true
    },
    "multipathRtt": {
      "type": "object",
      "required": [
        "samples",
        "minimum",
        "median",
        "maximum"
      ],
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "minimum": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/duration"
        },
        "median": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/duration"
        },
        "maximum": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/duration"
        }
      },
      "additionalProperties": true
    },
    "multipathSummary": {
      "type": "object",
      "required": [
        "planned_probes",
        "probes_sent",
        "answered_probes",
        "unanswered_probes",
        "replies_seen",
        "ambiguous_probes",
        "cleanup_packets",
        "retained_evidence_bytes",
        "omitted_frames",
        "sweeps_completed",
        "nodes",
        "edges",
        "branch_points",
        "rejoin_points",
        "changes",
        "incomplete"
      ],
      "properties": {
        "planned_probes": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "probes_sent": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "answered_probes": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "unanswered_probes": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "replies_seen": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "ambiguous_probes": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "cleanup_packets": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "retained_evidence_bytes": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "omitted_frames": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "sweeps_completed": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "nodes": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "edges": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "branch_points": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "rejoin_points": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "changes": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "incomplete": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "multipathTopology": {
      "type": "object",
      "required": [
        "nodes",
        "edges",
        "changes"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/multipathNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/multipathEdge"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/multipathChange"
          }
        }
      },
      "additionalProperties": true
    },
    "multipathUnmatched": {
      "type": "object",
      "required": [
        "sweep",
        "hop_limit",
        "frame"
      ],
      "properties": {
        "sweep": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "hop_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "frame": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/frame"
        }
      },
      "additionalProperties": true
    },
    "tracerouteResult": {
      "type": "object",
      "required": [
        "target",
        "resolved_addresses",
        "destination",
        "strategy",
        "hops",
        "undecoded",
        "completion",
        "retained_evidence_bytes"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "resolved_addresses": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
          },
          "minItems": 1
        },
        "destination": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
        },
        "strategy": {
          "type": "string",
          "enum": [
            "udp",
            "icmp",
            "tcp"
          ]
        },
        "destination_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "hops": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/traceHop"
          }
        },
        "undecoded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "hop_limit",
              "frame"
            ],
            "properties": {
              "hop_limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "frame": {
                "$ref": "urn:packetcraftr:output:common:v1#/$defs/frame"
              }
            },
            "additionalProperties": true
          }
        },
        "completion": {
          "type": "string",
          "enum": [
            "destination_reached",
            "unreachable",
            "maximum_hops",
            "timeout"
          ]
        },
        "retained_evidence_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "icmp"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "destination_port"
              ]
            }
          },
          "else": {
            "required": [
              "destination_port"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "tracerouteStreamSuccess": {
      "type": "object",
      "properties": {
        "command": {
          "const": "traceroute"
        }
      },
      "required": [
        "command",
        "result"
      ],
      "oneOf": [
        {
          "properties": {
            "event": {
              "const": "probe"
            },
            "result": {
              "type": "object",
              "required": [
                "target",
                "probe"
              ],
              "properties": {
                "target": {
                  "type": "string"
                },
                "probe": {
                  "$ref": "urn:packetcraftr:output:common:v1#/$defs/traceProbe"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "diagnostic"
            },
            "result": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/diagnosticEvent"
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "undecoded"
            },
            "result": {
              "type": "object",
              "required": [
                "hop_limit",
                "frame"
              ],
              "properties": {
                "hop_limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 255
                },
                "frame": {
                  "$ref": "urn:packetcraftr:output:common:v1#/$defs/frame"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "complete"
            },
            "result": {
              "type": "object",
              "required": [
                "target",
                "resolved_addresses",
                "destination",
                "strategy",
                "completion"
              ],
              "properties": {
                "target": {
                  "type": "string"
                },
                "resolved_addresses": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
                  },
                  "minItems": 1
                },
                "destination": {
                  "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
                },
                "strategy": {
                  "type": "string",
                  "enum": [
                    "udp",
                    "icmp",
                    "tcp"
                  ]
                },
                "destination_port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "completion": {
                  "type": "string",
                  "enum": [
                    "destination_reached",
                    "unreachable",
                    "maximum_hops",
                    "timeout"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "strategy": {
                        "const": "icmp"
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "destination_port"
                      ]
                    }
                  },
                  "else": {
                    "required": [
                      "destination_port"
                    ]
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "flow"
            },
            "result": {
              "type": "object",
              "required": [
                "mode",
                "flow"
              ],
              "properties": {
                "mode": {
                  "const": "multipath"
                },
                "flow": {
                  "$ref": "#/$defs/multipathFlow"
                }
              },
              "additionalProperties": true
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "probe"
            },
            "result": {
              "type": "object",
              "required": [
                "mode",
                "probe"
              ],
              "properties": {
                "mode": {
                  "const": "multipath"
                },
                "probe": {
                  "$ref": "#/$defs/multipathProbe"
                }
              },
              "additionalProperties": true
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "topology"
            },
            "result": {
              "type": "object",
              "required": [
                "mode",
                "topology"
              ],
              "properties": {
                "mode": {
                  "const": "multipath"
                },
                "topology": {
                  "$ref": "#/$defs/multipathTopology"
                }
              },
              "additionalProperties": true
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "flow_complete"
            },
            "result": {
              "type": "object",
              "required": [
                "mode",
                "completion"
              ],
              "properties": {
                "mode": {
                  "const": "multipath"
                },
                "completion": {
                  "$ref": "#/$defs/multipathCompletion"
                }
              },
              "additionalProperties": true
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "unmatched"
            },
            "result": {
              "type": "object",
              "required": [
                "mode",
                "unmatched"
              ],
              "properties": {
                "mode": {
                  "const": "multipath"
                },
                "unmatched": {
                  "$ref": "#/$defs/multipathUnmatched"
                }
              },
              "additionalProperties": true
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
