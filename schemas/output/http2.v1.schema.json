        "dependency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "additionalProperties": true
    },
    "http2Result": {
      "type": "object",
      "required": [
        "frames_read",
        "frames_matched",
        "summary",
        "scopes",
        "incomplete_datagrams",
        "source_outcomes_omitted",
        "ip_reassembly",
        "frames",
        "messages",
        "issues",
        "connections"
      ],
      "properties": {
        "frames_read": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "frames_matched": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "summary": {
          "$ref": "#/$defs/http2Summary"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/captureScope"
          }
