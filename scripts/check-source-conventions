#!/usr/bin/env bash
# Copyright (C) 2026 tyk-swe
# SPDX-License-Identifier: AGPL-3.0-only

# Enforces the source convention that every Rust file opens with the
# copyright/SPDX header pair.

set -euo pipefail

cd "$(dirname "$0")/.."

status=0

expected_copyright='// Copyright (C) 2026 tyk-swe'
expected_spdx='// SPDX-License-Identifier: AGPL-3.0-only'

report() {
    printf '%s: %s\n' "$1" "$2" >&2
    status=1
}

files() {
    find crates fuzz/fuzz_targets -name '*.rs' -type f 2>/dev/null | sort
}

while IFS= read -r file; do
    mapfile -t header < <(sed -n '1,2p' "$file")
    if [[ ${header[0]-} != "$expected_copyright" || ${header[1]-} != "$expected_spdx" ]]; then
        report "$file" 'missing the copyright/SPDX header pair on lines 1-2'
    fi
done < <(files)

if ((status == 0)); then
    printf 'source conventions: %s files checked, all clean\n' "$(files | wc -l | tr -d ' ')"
fi

exit "$status"
