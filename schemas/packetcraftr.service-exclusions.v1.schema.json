{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "packetcraftr.service-exclusions/v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "$ref": "#/$defs/text"
    },
    "entries": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transport",
          "ports",
          "reason",
          "metadata"
        ],
        "properties": {
          "transport": {
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "ports": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2048,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "reason": {
            "$ref": "#/$defs/text"
          },
          "metadata": {
            "$ref": "#/$defs/metadata"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packetcraftr.dev/schemas/packetcraftr.service-exclusions.v1.schema.json",
  "title": "PacketcraftR sensitive-service identification exclusions",
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "reference",
        "license",
        "maintainer",
        "updated"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/text"
        },
        "reference": {
          "$ref": "#/$defs/text"
        },
        "license": {
          "$ref": "#/$defs/text"
        },
        "maintainer": {
          "$ref": "#/$defs/text"
        },
        "updated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    }
  }
}
