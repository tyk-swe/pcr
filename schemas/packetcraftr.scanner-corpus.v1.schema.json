{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "packetcraftr.scanner-corpus/v1",
  "title": "Independent scanner ground-truth inventory",
  "type": "object",
  "required": ["schema", "dataset_version", "families", "transports", "fixture_addresses", "request", "nmap", "scenarios", "native_connect_scenarios", "traceroute_scenarios", "identification_scenarios", "provenance"],
  "additionalProperties": false,
  "properties": {
    "identification_scenarios": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/identificationScenario"}},
    "schema": {"const": "packetcraftr.scanner-corpus/v1"},
    "dataset_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "families": {"const": ["ipv4", "ipv6"]},
    "transports": {"const": ["tcp", "udp", "icmp"]},
    "fixture_addresses": {
      "type": "object",
      "required": ["ipv4", "ipv6"],
      "additionalProperties": false,
      "properties": {"ipv4": {"$ref": "#/$defs/addresses"}, "ipv6": {"$ref": "#/$defs/addresses"}}
    },
    "request": {
      "type": "object",
      "required": ["attempts", "ports", "timeout_ms", "max_duration_ms", "max_probes", "max_evidence_bytes", "windows"],
      "additionalProperties": false,
      "properties": {
        "attempts": {"const": 1},
        "ports": {"const": [443]},
        "timeout_ms": {"const": 20},
        "max_duration_ms": {"const": 2000},
        "max_probes": {"const": 1},
        "max_evidence_bytes": {"const": 65536},
        "windows": {"const": [1, 2]}
      }
    },
    "nmap": {
      "type": "object",
      "required": ["version", "acquisition", "connect_arguments", "limitations"],
      "additionalProperties": false,
      "properties": {
        "version": {"const": "7.991"},
        "acquisition": {"$ref": "#/$defs/text"},
        "connect_arguments": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "limitations": {"$ref": "#/$defs/text"}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "condition", "provision", "expected", "divergence"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["responsive", "closed", "blocked", "silent", "malformed", "unrelated"]},
          "condition": {"$ref": "#/$defs/text"},
          "provision": {"$ref": "#/$defs/text"},
          "expected": {
            "type": "object",
            "required": ["attempt_classification", "status", "attributed_response"],
            "additionalProperties": false,
            "properties": {
              "attempt_classification": {"enum": ["open", "closed", "filtered", "timeout"]},
              "status": {"enum": ["response", "timeout"]},
              "attributed_response": {"type": "boolean"}
            }
          },
          "expected_by_transport": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "icmp": {
                "type": "object",
                "required": ["attempt_classification", "status", "attributed_response"],
                "additionalProperties": false,
                "properties": {
                  "attempt_classification": {"const": "unreachable"},
                  "status": {"const": "response"},
                  "attributed_response": {"const": true}
                }
              }
            }
          },
          "divergence": {"$ref": "#/$defs/text"}
        }
      }
    },
    "native_connect_scenarios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "condition", "expected_outcome", "expected_classification", "nmap_expected", "divergence"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["connect-responsive", "connect-closed"]},
          "condition": {"$ref": "#/$defs/text"},
          "expected_outcome": {"enum": ["connected", "refused"]},
          "expected_classification": {"enum": ["open", "closed"]},
          "nmap_expected": {"enum": ["open", "closed"]},
          "divergence": {"$ref": "#/$defs/text"}
        }
      }
    },
    "traceroute_scenarios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "condition", "expected_termination", "expected_status", "expected_attributed_response", "divergence"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["responsive", "silent"]},
          "condition": {"$ref": "#/$defs/text"},
          "expected_termination": {"enum": ["destination_reached", "timeout"]},
          "expected_status": {"enum": ["response", "timeout"]},
          "expected_attributed_response": {"type": "boolean"},
          "divergence": {"$ref": "#/$defs/text"}
        }
      }
    },
    "target_planning_scenarios": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "type": "object",
          "required": [
            "id",
            "condition",
            "include",
            "expected_addresses",
            "expected_resolution_performed",
            "divergence"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "numeric-source-equivalence"
            },
            "condition": {
              "$ref": "#/$defs/text"
            },
            "include": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "expected_addresses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "expected_resolution_performed": {
              "type": "boolean"
            },
            "divergence": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "condition",
            "include",
            "exclude",
            "expected_addresses",
            "family_include",
            "family",
            "expected_family_addresses",
            "divergence"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "numeric-narrowing"
            },
            "condition": {
              "$ref": "#/$defs/text"
            },
            "include": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "exclude": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "expected_addresses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "family_include": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "family": {
              "enum": [
                "ipv4",
                "ipv6"
              ]
            },
            "expected_family_addresses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "divergence": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "condition",
            "expected",
            "divergence"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "manifest-boundaries"
            },
            "condition": {
              "$ref": "#/$defs/text"
            },
            "expected": {
              "type": "object",
              "required": [
                "input_errors_before_active_work",
                "duplicate_diagnostic",
                "source_position_retained",
                "unique_stdin_consumer"
              ],
              "additionalProperties": false,
              "properties": {
                "input_errors_before_active_work": {
                  "type": "boolean"
                },
                "duplicate_diagnostic": {
                  "$ref": "#/$defs/text"
                },
                "source_position_retained": {
                  "type": "boolean"
                },
                "unique_stdin_consumer": {
                  "type": "boolean"
                }
              }
            },
            "divergence": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "condition",
            "expected",
            "divergence"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "scoped-host-local"
            },
            "condition": {
              "$ref": "#/$defs/text"
            },
            "expected": {
              "type": "object",
              "required": [
                "selected_targets",
                "origins",
                "scope_interface_retained",
                "connect_outcome",
                "connect_classification",
                "raw",
                "portable"
              ],
              "additionalProperties": false,
              "properties": {
                "selected_targets": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "origins": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "scope_interface_retained": {
                  "type": "boolean"
                },
                "connect_outcome": {
                  "$ref": "#/$defs/text"
                },
                "connect_classification": {
                  "$ref": "#/$defs/text"
                },
                "raw": {
                  "$ref": "#/$defs/text"
                },
                "portable": {
                  "$ref": "#/$defs/text"
                }
              }
            },
            "divergence": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "condition",
            "expected",
            "divergence"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "scoped-isolated-links"
            },
            "condition": {
              "$ref": "#/$defs/text"
            },
            "expected": {
              "type": "object",
              "required": [
                "selected_targets",
                "alias_origins",
                "correct_zone_connect",
                "other_zone_connect",
                "raw_open",
                "raw_closed",
                "scope_interface_retained"
              ],
              "additionalProperties": false,
              "properties": {
                "selected_targets": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "alias_origins": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "correct_zone_connect": {
                  "$ref": "#/$defs/text"
                },
                "other_zone_connect": {
                  "$ref": "#/$defs/text"
                },
                "raw_open": {
                  "$ref": "#/$defs/text"
                },
                "raw_closed": {
                  "$ref": "#/$defs/text"
                },
                "scope_interface_retained": {
                  "type": "boolean"
                }
              }
            },
            "divergence": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ],
      "items": false
    },
    "discovery_scenarios": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "condition",
          "provision",
          "families",
          "expected",
          "measurement_scope"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "discovery-responsive",
              "discovery-closed-but-responsive",
              "discovery-silent",
              "discovery-blocked",
              "discovery-routed",
              "discovery-shared-link-address"
            ]
          },
          "condition": {
            "$ref": "#/$defs/text"
          },
          "provision": {
            "const": "injected_provider_and_controlled_native"
          },
          "families": {
            "const": [
              "ipv4",
              "ipv6"
            ]
          },
          "expected": {
            "type": "object",
            "required": [
              "state",
              "reply_by_probe",
              "basis",
              "responded_reasons"
            ],
            "additionalProperties": false,
            "properties": {
              "state": {
                "enum": [
                  "responded",
                  "no_response"
                ]
              },
              "reply_by_probe": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "icmp": {
                    "enum": [
                      null,
                      "icmp_echo_reply",
                      "tcp_syn_ack",
                      "udp_payload",
                      "tcp_reset",
                      "icmp_port_unreachable",
                      "icmp_administratively_prohibited",
                      "icmp_destination_unreachable",
                      "neighbor_reply"
                    ]
                  },
                  "tcp": {
                    "enum": [
                      null,
                      "icmp_echo_reply",
                      "tcp_syn_ack",
                      "udp_payload",
                      "tcp_reset",
                      "icmp_port_unreachable",
                      "icmp_administratively_prohibited",
                      "icmp_destination_unreachable",
                      "neighbor_reply"
                    ]
                  },
                  "udp": {
                    "enum": [
                      null,
                      "icmp_echo_reply",
                      "tcp_syn_ack",
                      "udp_payload",
                      "tcp_reset",
                      "icmp_port_unreachable",
                      "icmp_administratively_prohibited",
                      "icmp_destination_unreachable",
                      "neighbor_reply"
                    ]
                  },
                  "neighbor": {
                    "enum": [
                      null,
                      "icmp_echo_reply",
                      "tcp_syn_ack",
                      "udp_payload",
                      "tcp_reset",
                      "icmp_port_unreachable",
                      "icmp_administratively_prohibited",
                      "icmp_destination_unreachable",
                      "neighbor_reply"
                    ]
                  }
                }
              },
              "basis": {
                "enum": [
                  "direct",
                  "possible_proxy"
                ]
              },
              "responded_reasons": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          },
          "measurement_scope": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "adaptive_scheduling_scenarios": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "condition", "provision", "families", "expected", "measurement_scope"],
        "additionalProperties": false,
        "properties": {
          "id": {"enum": ["adaptive-responsive", "adaptive-selective-retry", "adaptive-rate-limited-control", "adaptive-fair-hosts", "adaptive-host-deadline", "adaptive-window-loss", "adaptive-connect-cleanup", "adaptive-plan-boundary"]},
          "condition": {"$ref": "#/$defs/text"},
          "provision": {"enum": ["injected_provider_virtual_clock", "injected_provider_isolated_process"]},
          "families": {"const": ["ipv4", "ipv6"]},
          "expected": {"$ref": "#/$defs/text"},
          "measurement_scope": {"$ref": "#/$defs/text"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "retrieved", "transforms", "license", "license_rationale", "maintainer", "refresh", "coverage"],
      "additionalProperties": false,
      "properties": {
        "source": {"$ref": "#/$defs/text"},
        "retrieved": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "transforms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "license": {"const": "AGPL-3.0-only"},
        "license_rationale": {"$ref": "#/$defs/text"},
        "maintainer": {"$ref": "#/$defs/text"},
        "refresh": {"$ref": "#/$defs/text"},
        "coverage": {"$ref": "#/$defs/text"}
      }
    }
  },
  "$defs": {
    "identificationScenario": {
      "type": "object",
      "required": [
        "id",
        "condition",
        "provision",
        "families",
        "transport",
        "expected",
        "measurement_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^identification-[a-z-]+$"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "provision": {
          "enum": [
            "protocol_fixture",
            "loopback_or_recording_provider"
          ]
        },
        "families": {
          "const": [
            "ipv4",
            "ipv6"
          ]
        },
        "transport": {
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "measurement_scope": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "object",
          "required": [
            "outcome",
            "product",
            "version",
            "confidence"
          ],
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "enum": [
                "matched",
                "unknown",
                "ambiguous",
                "malformed",
                "truncated",
                "excluded"
              ]
            },
            "product": {
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "enum": [
                "claim",
                "protocol",
                null
              ]
            }
          }
        }
      }
    },

    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "addresses": {
      "type": "object",
      "required": ["source", "destination", "router"],
      "additionalProperties": false,
      "properties": {"source": {"type": "string"}, "destination": {"type": "string"}, "router": {"type": "string"}}
    }
  }
}
