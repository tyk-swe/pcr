{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:packetcraftr:port-catalog:v1",
  "title": "PacketcraftR port catalog v1",
  "type": "object",
  "required": [
    "schema",
    "name",
    "version",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "packetcraftr.port-catalog/v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "transport",
          "port",
          "name",
          "reference"
        ],
        "additionalProperties": false,
        "properties": {
          "transport": {
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          }
        }
      }
    },
    "presets": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "tcp"
            ],
            "properties": {
              "tcp": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "udp"
            ],
            "properties": {
              "udp": {
                "minItems": 1
              }
            }
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "tcp": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            }
          },
          "udp": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            }
          }
        }
      }
    }
  }
}
