{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:packetcraftr:output:messages:v1",
  "title": "PacketcraftR messages output payload v1",
  "description": "Success payload contract for the messages command. The stable envelope is validated separately.",
  "allOf": [
    {
      "type": "object",
      "required": [
        "command",
        "payload_schema"
      ],
      "properties": {
        "command": {
          "const": "messages"
        },
        "payload_schema": {
          "const": "packetcraftr.output.messages/v1"
        }
      }
    },
    {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/aggregateSuccessEnvelope"
            },
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/messagesSuccess"
                }
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/streamSuccessEnvelope"
            },
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/messagesStreamSuccess"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "$defs": {
    "messageIssue": {
      "type": "object",
      "required": [
        "number",
        "flow",
        "stream",
        "status"
      ],
      "properties": {
        "number": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "flow": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/applicationFlow"
        },
        "stream": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "malformed",
            "unsupported",
            "gap",
            "conflict",
            "reset",
            "evicted"
          ]
        }
      },
      "additionalProperties": true
    },
    "messageRecord": {
      "type": "object",
      "required": [
        "index",
        "stream",
        "generation",
        "flow",
        "error",
        "sources",
        "protocol",
        "status",
        "wire_hex",
        "packet"
      ],
      "properties": {
        "index": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "stream": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "generation": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "flow": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/applicationFlow"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/applicationSource"
          }
        },
        "protocol": {
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "malformed",
            "unsupported",
            "gap",
            "conflict",
            "reset",
            "evicted"
          ]
        },
        "wire_hex": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
        },
        "packet": {
          "anyOf": [
            {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/packetDocument"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "messagesComplete": {
      "type": "object",
      "required": [
        "frames_read",
        "frames_matched",
        "summary",
        "scopes",
        "incomplete_datagrams",
        "source_outcomes_omitted",
        "ip_reassembly"
      ],
      "properties": {
        "frames_read": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "frames_matched": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "summary": {
          "$ref": "#/$defs/messagesSummary"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/captureScope"
          }
        },
        "incomplete_datagrams": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "source_outcomes_omitted": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "ip_reassembly": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipReassemblyReport"
        }
      },
      "additionalProperties": true
    },
    "messagesResult": {
      "type": "object",
      "required": [
        "frames_read",
        "frames_matched",
        "summary",
        "scopes",
        "incomplete_datagrams",
        "source_outcomes_omitted",
        "ip_reassembly",
        "messages",
        "issues"
      ],
      "properties": {
        "frames_read": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "frames_matched": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "summary": {
          "$ref": "#/$defs/messagesSummary"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/captureScope"
          }
        },
        "incomplete_datagrams": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "source_outcomes_omitted": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "ip_reassembly": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipReassemblyReport"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/messageRecord"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/messageIssue"
          }
        }
      },
      "additionalProperties": true
    },
    "messagesStreamSuccess": {
      "type": "object",
      "required": [
        "command",
        "event",
        "result"
      ],
      "properties": {
        "command": {
          "const": "messages"
        }
      },
      "oneOf": [
        {
          "required": [
            "event",
            "result"
          ],
          "properties": {
            "event": {
              "const": "protocol_message"
            },
            "result": {
              "$ref": "#/$defs/messageRecord"
            }
          }
        },
        {
          "required": [
            "event",
            "result"
          ],
          "properties": {
            "event": {
              "const": "protocol_issue"
            },
            "result": {
              "$ref": "#/$defs/messageIssue"
            }
          }
        },
        {
          "required": [
            "event",
            "result"
          ],
          "properties": {
            "event": {
              "const": "complete"
            },
            "result": {
              "$ref": "#/$defs/messagesComplete"
            }
          }
        },
        {
          "properties": {
            "event": {
              "const": "ip_overlap_resolved"
            },
            "result": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipOverlapResolvedEvent"
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "ip_datagram_completed"
            },
            "result": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipDatagramCompletedEvent"
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "ip_datagram_incomplete"
            },
            "result": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipDatagramIncompleteEvent"
            }
          },
          "required": [
            "event",
            "result"
          ]
        }
      ]
    },
    "messagesSuccess": {
      "type": "object",
      "required": [
        "command",
        "result"
      ],
      "properties": {
        "command": {
          "const": "messages"
        },
        "result": {
          "$ref": "#/$defs/messagesResult"
        }
      }
    },
    "messagesSummary": {
      "type": "object",
      "required": [
        "messages",
        "complete_messages",
        "incomplete_messages",
        "malformed_messages",
        "unsupported_messages",
        "by_protocol"
      ],
      "properties": {
        "messages": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "complete_messages": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "incomplete_messages": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "malformed_messages": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "unsupported_messages": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "by_protocol": {
          "type": "object",
          "additionalProperties": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
