{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "probes",
    "matches"
  ],
  "properties": {
    "schema": {
      "const": "packetcraftr.service-probes/v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "$ref": "#/$defs/text"
    },
    "probes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "transport",
          "intensity",
          "request",
          "metadata",
          "read_only_review"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "transport": {
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "intensity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "request": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "banner"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "http_head"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "payload"
                ],
                "properties": {
                  "type": {
                    "const": "dns"
                  },
                  "payload": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "name",
                      "recursion_desired"
                    ],
                    "properties": {
                      "type": {
                        "const": "dns"
                      },
                      "name": {
                        "type": "string",
                        "enum": [
                          ".",
                          "version.bind.",
                          "version.bind"
                        ]
                      },
                      "query_type": {
                        "type": "integer",
                        "enum": [
                          1,
                          16
                        ]
                      },
                      "class": {
                        "type": "integer",
                        "enum": [
                          1,
                          3
                        ]
                      },
                      "recursion_desired": {
                        "const": false
                      },
                      "id_base": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "name": {
                              "const": "."
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "query_type": {
                              "const": 1
                            },
                            "class": {
                              "const": 1
                            }
                          }
                        },
                        "else": {
                          "required": [
                            "query_type",
                            "class"
                          ],
                          "properties": {
                            "query_type": {
                              "const": 16
                            },
                            "class": {
                              "const": 3
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "smtp_greeting"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "ftp_greeting"
                  }
                }
              }
            ]
          },
          "metadata": {
            "$ref": "#/$defs/metadata"
          },
          "read_only_review": {
            "$ref": "#/$defs/review"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "transport": {
                  "const": "udp"
                }
              }
            },
            "then": {
              "properties": {
                "request": {
                  "properties": {
                    "type": {
                      "const": "dns"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "matches": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "probe",
          "field",
          "prefix",
          "product",
          "metadata"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "probe": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "field": {
            "enum": [
              "ssh_banner",
              "ssh_software",
              "http_status",
              "http_server",
              "dns_rcode",
              "dns_txt",
              "smtp_greeting",
              "smtp_software",
              "ftp_greeting"
            ]
          },
          "prefix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[ -~]+$"
          },
          "product": {
            "$ref": "#/$defs/text"
          },
          "version": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "max_bytes",
                  "stop_at"
                ],
                "properties": {
                  "max_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "stop_at": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[\\u0000-\\u007f]+$"
                  }
                }
              }
            ]
          },
          "metadata": {
            "$ref": "#/$defs/metadata"
          },
          "hostname_field": {
            "enum": [
              "smtp_hostname",
              null
            ]
          },
          "device_type": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/text"
              }
            ]
          },
          "cpe": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512,
            "pattern": "^cpe:2\\.3:[aho]:(?:[A-Za-z0-9._-]{2,}|[A-Za-z0-9._]):(?:[A-Za-z0-9._-]{2,}|[A-Za-z0-9._]):\\*:(?:\\*|-|[A-Za-z0-9._-]+)(?::(?:\\*|-|[A-Za-z0-9._-]+)){6}$(?![\\s\\S])"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "field": {
                  "enum": [
                    "http_status",
                    "dns_rcode"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "version": {
                  "type": "null"
                },
                "cpe": {
                  "type": "null"
                },
                "device_type": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "field": {
                  "const": "dns_rcode"
                }
              }
            },
            "then": {
              "properties": {
                "product": {
                  "const": "DNS service"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "field": {
                  "const": "http_status"
                }
              }
            },
            "then": {
              "properties": {
                "product": {
                  "const": "HTTP service"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "hostname_field"
              ],
              "properties": {
                "hostname_field": {
                  "const": "smtp_hostname"
                }
              }
            },
            "then": {
              "properties": {
                "field": {
                  "enum": [
                    "smtp_greeting",
                    "smtp_software"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packetcraftr.dev/schemas/packetcraftr.service-probes.v1.schema.json",
  "title": "PacketcraftR bounded read-only service probes and claim matches",
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "reference",
        "license",
        "maintainer",
        "updated"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/text"
        },
        "reference": {
          "$ref": "#/$defs/text"
        },
        "license": {
          "$ref": "#/$defs/text"
        },
        "maintainer": {
          "$ref": "#/$defs/text"
        },
        "updated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_by",
        "reviewed",
        "statement"
      ],
      "properties": {
        "reviewed_by": {
          "$ref": "#/$defs/text"
        },
        "reviewed": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "statement": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      }
    }
  }
}
