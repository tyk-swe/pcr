{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:packetcraftr:output:http2:v1",
  "title": "PacketcraftR http2 output payload v1",
  "description": "Success payload contract for the http2 command. The stable envelope is validated separately.",
  "allOf": [
    {
      "type": "object",
      "required": [
        "command",
        "payload_schema"
      ],
      "properties": {
        "command": {
          "const": "http2"
        },
        "payload_schema": {
          "const": "packetcraftr.output.http2/v1"
        }
      }
    },
    {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/aggregateSuccessEnvelope"
            },
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/http2Success"
                }
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/streamSuccessEnvelope"
            },
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/http2StreamSuccess"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "$defs": {
    "http2Complete": {
      "type": "object",
      "required": [
        "frames_read",
        "frames_matched",
        "summary",
        "scopes",
        "incomplete_datagrams",
        "source_outcomes_omitted",
        "ip_reassembly"
      ],
      "properties": {
        "frames_read": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "frames_matched": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "summary": {
          "$ref": "#/$defs/http2Summary"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/captureScope"
          }
        },
        "incomplete_datagrams": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "source_outcomes_omitted": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "ip_reassembly": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipReassemblyReport"
        }
      },
      "additionalProperties": true
    },
    "http2Connection": {
      "type": "object",
      "required": [
        "stream",
        "generation",
        "flow",
        "startup",
        "status",
        "client_settings",
        "server_settings",
        "client_window",
        "server_window",
        "streams",
        "frames",
        "issues",
        "pending_settings",
        "pending_pings",
        "upgrade_response",
        "upgrade_sources"
      ],
      "properties": {
        "stream": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "generation": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "flow": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/applicationFlow"
        },
        "startup": {
          "enum": [
            "prior_knowledge",
            "h2c",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "malformed",
            "limit",
            "gap",
            "conflict",
            "reset",
            "evicted",
            "unprocessed",
            "unsupported"
          ]
        },
        "client_settings": {
          "$ref": "#/$defs/http2PeerSettings"
        },
        "server_settings": {
          "$ref": "#/$defs/http2PeerSettings"
        },
        "client_window": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "server_window": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "streams": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "frames": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "issues": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "pending_settings": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "pending_pings": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "upgrade_response": {
          "anyOf": [
            {
              "$ref": "#/$defs/http2UpgradeHead"
            },
            {
              "type": "null"
            }
          ]
        },
        "upgrade_sources": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/applicationSource"
          }
        }
      },
      "additionalProperties": true
    },
    "http2Control": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "fragment_hex",
            "priority",
            "padding_hex"
          ],
          "properties": {
            "type": {
              "const": "headers"
            },
            "fragment_hex": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
            },
            "priority": {
              "anyOf": [
                {
                  "$ref": "#/$defs/http2Priority"
                },
                {
                  "type": "null"
                }
              ]
            },
            "padding_hex": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "exclusive",
            "dependency",
            "weight"
          ],
          "properties": {
            "type": {
              "const": "priority"
            },
            "exclusive": {
              "type": "boolean"
            },
            "dependency": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "error_code"
          ],
          "properties": {
            "type": {
              "const": "reset"
            },
            "error_code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "settings"
          ],
          "properties": {
            "type": {
              "const": "settings"
            },
            "settings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/http2Setting"
              }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "promised_stream_id",
            "fragment_hex",
            "padding_hex"
          ],
          "properties": {
            "type": {
              "const": "push_promise"
            },
            "promised_stream_id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "fragment_hex": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
            },
            "padding_hex": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "opaque_hex"
          ],
          "properties": {
            "type": {
              "const": "ping"
            },
            "opaque_hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "last_stream_id",
            "error_code",
            "debug_hex"
          ],
          "properties": {
            "type": {
              "const": "goaway"
            },
            "last_stream_id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "error_code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "debug_hex": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "increment"
          ],
          "properties": {
            "type": {
              "const": "window_update"
            },
            "increment": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "fragment_hex"
          ],
          "properties": {
            "type": {
              "const": "continuation"
            },
            "fragment_hex": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "payload_hex"
          ],
          "properties": {
            "type": {
              "const": "unknown"
            },
            "payload_hex": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "http2Frame": {
      "type": "object",
      "required": [
        "index",
        "stream",
        "generation",
        "flow",
        "http2_stream_id",
        "length",
        "frame_type",
        "flags",
        "reserved",
        "header_wire_hex",
        "control",
        "payload_wire_hex",
        "data_bytes",
        "padding_bytes",
        "sources"
      ],
      "properties": {
        "index": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "stream": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "generation": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "flow": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/applicationFlow"
        },
        "http2_stream_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777215
        },
        "frame_type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "reserved": {
          "type": "boolean"
        },
        "header_wire_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{18}$"
        },
        "control": {
          "anyOf": [
            {
              "$ref": "#/$defs/http2Control"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload_wire_hex": {
          "anyOf": [
            {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
            },
            {
              "type": "null"
            }
          ]
        },
        "data_bytes": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "padding_bytes": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/applicationSource"
          }
        }
      },
      "additionalProperties": true
    },
    "http2Header": {
      "type": "object",
      "required": [
        "name",
        "name_hex",
        "value",
        "value_hex",
        "never_indexed"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "name_hex": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
        },
        "value": {
          "type": "string"
        },
        "value_hex": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
        },
        "never_indexed": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "http2Issue": {
      "type": "object",
      "required": [
        "number",
        "stream",
        "generation",
        "http2_stream_id",
        "flow",
        "code",
        "scope",
        "certainty",
        "status",
        "detail",
        "wire_hex",
        "sources"
      ],
      "properties": {
        "number": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "stream": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "generation": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "http2_stream_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "flow": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/applicationFlow"
        },
        "code": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "connection",
            "stream",
            "compression",
            "capture"
          ]
        },
        "certainty": {
          "enum": [
            "confirmed",
            "observed_order",
            "indeterminate"
          ]
        },
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "malformed",
            "limit",
            "gap",
            "conflict",
            "reset",
            "evicted",
            "unprocessed",
            "unsupported"
          ]
        },
        "detail": {
          "type": "string"
        },
        "wire_hex": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/applicationSource"
          }
        }
      },
      "additionalProperties": true
    },
    "http2Message": {
      "type": "object",
      "required": [
        "index",
        "stream",
        "generation",
        "http2_stream_id",
        "flow",
        "kind",
        "request",
        "promised_by",
        "status",
        "headers",
        "trailers",
        "header_blocks_hex",
        "upgrade_head",
        "body_bytes",
        "sources",
        "compression_sources"
      ],
      "properties": {
        "index": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "stream": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "generation": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "http2_stream_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "flow": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/applicationFlow"
        },
        "kind": {
          "enum": [
            "request",
            "response",
            "informational",
            "push_promise"
          ]
        },
        "request": {
          "anyOf": [
            {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
            },
            {
              "type": "null"
            }
          ]
        },
        "promised_by": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "malformed",
            "limit",
            "gap",
            "conflict",
            "reset",
            "evicted",
            "unprocessed",
            "unsupported"
          ]
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/http2Header"
          }
        },
        "trailers": {
          "type": "array",
          "items": {
