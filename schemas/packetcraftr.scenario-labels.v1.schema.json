{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:packetcraftr:scenario-labels:v1",
  "title": "PacketcraftR synthetic scenario labels v1",
  "type": "object",
  "required": [
    "schema",
    "scenario_label",
    "frames"
  ],
  "properties": {
    "schema": {
      "const": "packetcraftr.scenario-labels/v1"
    },
    "scenario_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "frames": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "frame",
          "timestamp_offset_ms",
          "step",
          "label",
          "tags",
          "repeat_index",
          "sha256",
          "captured_bytes"
        ],
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 1
          },
          "timestamp_offset_ms": {
            "type": "integer",
            "minimum": 0
          },
          "step": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "tags": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "repeat_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "captured_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
