{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:packetcraftr:indicators:v1",
  "title": "PacketcraftR local indicators v1",
  "type": "object",
  "required": [
    "schema",
    "indicators"
  ],
  "properties": {
    "schema": {
      "const": "packetcraftr.indicators/v1"
    },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "ip",
              "cidr",
              "domain",
              "domain_suffix",
              "ja3",
              "ja4"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
