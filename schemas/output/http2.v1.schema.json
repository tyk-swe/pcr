          }
        },
        "header_blocks_hex": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
          }
        },
        "upgrade_head": {
          "anyOf": [
            {
              "$ref": "#/$defs/http2UpgradeHead"
            },
            {
              "type": "null"
            }
          ]
        },
        "body_bytes": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/applicationSource"
          }
        },
        "compression_sources": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/applicationSource"
          }
        }
      },
      "additionalProperties": true
    },
    "http2PeerSettings": {
      "type": "object",
      "required": [
        "header_table_size",
