{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:packetcraftr:output:dns:v1",
  "title": "PacketcraftR dns output payload v1",
  "description": "Success payload contract for the dns command. The stable envelope is validated separately.",
  "allOf": [
    {
      "type": "object",
      "required": [
        "command",
        "payload_schema"
      ],
      "properties": {
        "command": {
          "const": "dns"
        },
        "payload_schema": {
          "const": "packetcraftr.output.dns/v1"
        }
      }
    },
    {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/aggregateSuccessEnvelope"
            },
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/dnsSuccess"
                }
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/streamSuccessEnvelope"
            },
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/dnsStreamSuccess"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "$defs": {
    "dnsAttempt": {
      "type": "object",
      "required": [
        "attempt",
        "transport",
        "server_address",
        "status",
        "reason"
      ],
      "properties": {
        "attempt": {
          "$ref": "#/$defs/dnsAttemptNumber"
        },
        "transport": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/dnsTransport"
        },
        "server_address": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
        },
        "source_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "status": {
          "$ref": "#/$defs/dnsAttemptStatus"
        },
        "sent_at": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/timestamp"
        },
        "received_at": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/timestamp"
        },
        "latency": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/duration"
        },
        "frame": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/frame"
        },
        "response_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "tcp"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "frame"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "transport": {
                "const": "udp"
              }
            }
          },
          "then": {
            "required": [
              "source_port",
              "sent_at"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "dnsAttemptNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "dnsAttemptStatus": {
      "type": "string",
      "enum": [
        "response",
        "truncated",
        "timeout",
        "unrelated",
        "decode_failure",
        "network_failure"
      ]
    },
    "dnsBatchResult": {
      "type": "object",
      "description": "Batch query result: the shared resolver plus each question's deterministic outcome in declared order.",
      "required": [
        "server",
        "server_port",
        "questions"
      ],
      "properties": {
        "server": {
          "type": "string"
        },
        "server_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "questions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/dnsQuestionResult"
          }
        }
      },
      "additionalProperties": true
    },
    "dnsEdns": {
      "type": "object",
      "required": [
        "udp_payload_size",
        "extended_response_code",
        "version",
        "dnssec_ok",
        "flags",
        "options"
      ],
      "properties": {
        "udp_payload_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "extended_response_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "dnssec_ok": {
          "type": "boolean"
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "data_hex"
            ],
            "properties": {
              "code": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "data_hex": {
                "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "dnsOutcome": {
      "type": "string",
      "enum": [
        "response",
        "truncated",
        "timeout",
        "unrelated",
        "decode_failure",
        "network_failure"
      ]
    },
    "dnsQueryType": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "dnsQuestionComplete": {
      "type": "object",
      "description": "One batch question's streamed terminal summary: uniform identity and status, the accepted outcome for completed, and the classified failure text for failed.",
      "required": [
        "query_name",
        "query_type",
        "transaction_id",
        "status"
      ],
      "properties": {
        "query_name": {
          "type": "string"
        },
        "query_type": {
          "$ref": "#/$defs/dnsQueryType"
        },
        "transaction_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "unattempted"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/dnsOutcome"
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "dnsQuestionResult": {
      "type": "object",
      "description": "One batch question: uniform identity and status, the classified failure text for failed, and the complete per-question result for completed.",
      "required": [
        "query_name",
        "query_type",
        "transaction_id",
        "status"
      ],
      "properties": {
        "query_name": {
          "type": "string"
        },
        "query_type": {
          "$ref": "#/$defs/dnsQueryType"
        },
        "transaction_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "unattempted"
          ]
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "$ref": "#/$defs/dnsSingleResult"
        }
      },
      "additionalProperties": true
    },
    "dnsRecord": {
      "type": "object",
      "required": [
        "owner",
        "class",
        "ttl",
        "type"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "class": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "ttl": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "type": {
          "type": "string",
          "enum": [
            "a",
            "aaaa",
            "caa",
            "cname",
            "mx",
            "ns",
            "ptr",
            "soa",
            "srv",
            "txt",
            "opt",
            "unknown"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "address"
          ],
          "properties": {
            "type": {
              "const": "a"
            },
            "address": {
              "type": "string",
              "format": "ipv4"
            }
          }
        },
        {
          "required": [
            "address"
          ],
          "properties": {
            "type": {
              "const": "aaaa"
            },
            "address": {
              "type": "string",
              "format": "ipv6"
            }
          }
        },
        {
          "required": [
            "flags",
            "tag",
            "tag_hex",
            "value",
            "value_hex"
          ],
          "properties": {
            "type": {
              "const": "caa"
            },
            "flags": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "tag": {
              "type": "string"
            },
            "tag_hex": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
            },
            "value": {
              "type": "string"
            },
            "value_hex": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
            }
          }
        },
        {
          "required": [
            "canonical_name"
          ],
          "properties": {
            "type": {
              "const": "cname"
            },
            "canonical_name": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "preference",
            "exchange"
          ],
          "properties": {
            "type": {
              "const": "mx"
            },
            "preference": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "exchange": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "name_server"
          ],
          "properties": {
            "type": {
              "const": "ns"
            },
            "name_server": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "pointer"
          ],
          "properties": {
            "type": {
              "const": "ptr"
            },
            "pointer": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "primary_name_server",
            "responsible_mailbox",
            "serial",
            "refresh",
            "retry",
            "expire",
            "minimum"
          ],
          "properties": {
            "type": {
              "const": "soa"
            },
            "primary_name_server": {
              "type": "string"
            },
            "responsible_mailbox": {
              "type": "string"
            },
            "serial": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "refresh": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "retry": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "expire": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "minimum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        {
          "required": [
            "priority",
            "weight",
            "port",
            "target"
          ],
          "properties": {
            "type": {
              "const": "srv"
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "weight": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "port": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "target": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "strings",
            "strings_hex"
          ],
          "properties": {
            "type": {
              "const": "txt"
            },
            "strings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "strings_hex": {
              "type": "array",
              "items": {
                "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
              }
            }
          }
        },
        {
          "required": [
            "edns"
          ],
          "properties": {
            "type": {
              "const": "opt"
            },
            "edns": {
              "$ref": "#/$defs/dnsEdns"
            }
          }
        },
        {
          "required": [
            "type_code",
            "rdata_hex"
          ],
          "properties": {
            "type": {
              "const": "unknown"
            },
            "type_code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "rdata_hex": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/hexBytes"
            }
          }
        }
      ],
      "unevaluatedProperties": true
    },
    "dnsRecords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dnsRecord"
      }
    },
    "dnsRejectedRecord": {
      "type": "object",
      "required": [
        "section",
        "index",
        "owner",
        "type_code",
        "reason"
      ],
      "properties": {
        "section": {
          "$ref": "#/$defs/dnsSection"
        },
        "index": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "owner": {
          "type": "string"
        },
        "type_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "dnsResult": {
      "anyOf": [
        {
          "$ref": "#/$defs/dnsSingleResult"
        },
        {
          "$ref": "#/$defs/dnsBatchResult"
        }
      ]
    },
    "dnsSection": {
      "type": "string",
      "enum": [
        "answer",
        "authority",
        "additional"
      ]
    },
    "dnsSingleResult": {
      "type": "object",
      "required": [
        "server",
        "server_port",
        "resolved_addresses",
        "query_name",
        "query_type",
        "transaction_id",
        "outcome",
        "fallback_attempted",
        "answers",
        "authorities",
        "additionals",
        "rejected_records",
        "rejected_record_count",
        "attempts",
        "undecoded"
      ],
      "properties": {
        "server": {
          "type": "string"
        },
        "server_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resolved_addresses": {
          "type": "array",
          "items": {
            "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
          },
          "minItems": 1
        },
        "query_name": {
          "type": "string"
        },
        "query_type": {
          "$ref": "#/$defs/dnsQueryType"
        },
        "transaction_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "outcome": {
          "$ref": "#/$defs/dnsOutcome"
        },
        "fallback_attempted": {
          "type": "boolean"
        },
        "accepted_transport": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/dnsTransport"
        },
        "response_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "response_code_name": {
          "type": "string"
        },
        "edns": {
          "$ref": "#/$defs/dnsEdns"
        },
        "authoritative": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "recursion_desired": {
          "type": "boolean"
        },
        "recursion_available": {
          "type": "boolean"
        },
        "authenticated_data": {
          "type": "boolean"
        },
        "checking_disabled": {
          "type": "boolean"
        },
        "answers": {
          "$ref": "#/$defs/dnsRecords"
        },
        "authorities": {
          "$ref": "#/$defs/dnsRecords"
        },
        "additionals": {
          "$ref": "#/$defs/dnsRecords"
        },
        "rejected_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dnsRejectedRecord"
          }
        },
        "rejected_record_count": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dnsAttempt"
          },
          "minItems": 1
        },
        "undecoded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dnsUndecoded"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "response",
                  "truncated"
                ]
              }
            }
          },
          "then": {
            "required": [
              "accepted_transport"
            ]
          },
          "else": {
            "not": {
              "required": [
                "accepted_transport"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "accepted_transport"
            ],
            "properties": {
              "accepted_transport": {
                "const": "tcp"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "response"
              },
              "attempts": {
                "contains": {
                  "required": [
                    "transport",
                    "status"
                  ],
                  "properties": {
                    "transport": {
                      "const": "tcp"
                    },
                    "status": {
                      "const": "response"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fallback_attempted": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "attempts": {
                "allOf": [
                  {
                    "contains": {
                      "required": [
                        "transport"
                      ],
                      "properties": {
                        "transport": {
                          "const": "tcp"
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "required": [
                        "transport",
                        "status"
                      ],
                      "properties": {
                        "transport": {
                          "const": "udp"
                        },
                        "status": {
                          "const": "truncated"
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "attempts": {
                "anyOf": [
                  {
                    "items": {
                      "properties": {
                        "transport": {
                          "const": "udp"
                        }
                      }
                    }
                  },
                  {
                    "items": {
                      "properties": {
                        "transport": {
                          "const": "tcp"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "dnsStreamSuccess": {
      "type": "object",
      "properties": {
        "command": {
          "const": "dns"
        }
      },
      "required": [
        "command",
        "result"
      ],
      "oneOf": [
        {
          "properties": {
            "event": {
              "const": "attempt"
            },
            "result": {
              "type": "object",
              "required": [
                "server",
                "server_port",
                "query_name",
                "query_type",
                "evidence"
              ],
              "properties": {
                "server": {
                  "type": "string"
                },
                "server_port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "query_name": {
                  "type": "string"
                },
                "query_type": {
                  "$ref": "#/$defs/dnsQueryType"
                },
                "evidence": {
                  "$ref": "#/$defs/dnsAttempt"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "record"
            },
            "result": {
              "type": "object",
              "required": [
                "attempt",
                "transport",
                "server",
                "server_port",
                "query_name",
                "query_type",
                "section",
                "record"
              ],
              "properties": {
                "attempt": {
                  "$ref": "#/$defs/dnsAttemptNumber"
                },
                "transport": {
                  "$ref": "urn:packetcraftr:output:common:v1#/$defs/dnsTransport"
                },
                "server": {
                  "type": "string"
                },
                "server_port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "query_name": {
                  "type": "string"
                },
                "query_type": {
                  "$ref": "#/$defs/dnsQueryType"
                },
                "section": {
                  "$ref": "#/$defs/dnsSection"
                },
                "record": {
                  "$ref": "#/$defs/dnsRecord"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "rejected"
            },
            "result": {
              "type": "object",
              "required": [
                "attempt",
                "transport",
                "server",
                "server_port",
                "query_name",
                "query_type",
                "record"
              ],
              "properties": {
                "attempt": {
                  "$ref": "#/$defs/dnsAttemptNumber"
                },
                "transport": {
                  "$ref": "urn:packetcraftr:output:common:v1#/$defs/dnsTransport"
                },
                "server": {
                  "type": "string"
                },
                "server_port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "query_name": {
                  "type": "string"
                },
                "query_type": {
                  "$ref": "#/$defs/dnsQueryType"
                },
                "record": {
                  "$ref": "#/$defs/dnsRejectedRecord"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "undecoded"
            },
            "result": {
              "type": "object",
              "required": [
                "evidence"
              ],
              "properties": {
                "evidence": {
                  "$ref": "#/$defs/dnsUndecoded"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "diagnostic"
            },
            "result": {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/diagnosticEvent"
            }
          },
          "required": [
            "event",
            "result"
          ]
        },
        {
          "properties": {
            "event": {
              "const": "complete"
            },
            "result": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "server",
                    "server_port",
                    "resolved_addresses",
                    "query_name",
                    "query_type",
                    "transaction_id",
                    "outcome",
                    "fallback_attempted",
                    "rejected_record_count"
                  ],
                  "properties": {
                    "server": {
                      "type": "string"
                    },
                    "server_port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "resolved_addresses": {
                      "type": "array",
                      "items": {
                        "$ref": "urn:packetcraftr:output:common:v1#/$defs/ipAddress"
                      },
                      "minItems": 1
                    },
                    "query_name": {
                      "type": "string"
                    },
                    "query_type": {
                      "$ref": "#/$defs/dnsQueryType"
                    },
                    "transaction_id": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535
                    },
                    "outcome": {
                      "$ref": "#/$defs/dnsOutcome"
                    },
                    "fallback_attempted": {
                      "type": "boolean"
                    },
                    "accepted_transport": {
                      "$ref": "urn:packetcraftr:output:common:v1#/$defs/dnsTransport"
                    },
                    "response_code": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    },
                    "response_code_name": {
                      "type": "string"
                    },
                    "edns": {
                      "$ref": "#/$defs/dnsEdns"
                    },
                    "authoritative": {
                      "type": "boolean"
                    },
                    "truncated": {
                      "type": "boolean"
                    },
                    "recursion_desired": {
                      "type": "boolean"
                    },
                    "recursion_available": {
                      "type": "boolean"
                    },
                    "authenticated_data": {
                      "type": "boolean"
                    },
                    "checking_disabled": {
                      "type": "boolean"
                    },
                    "rejected_record_count": {
                      "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "outcome": {
                            "enum": [
                              "response",
                              "truncated"
                            ]
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "accepted_transport"
                        ]
                      },
                      "else": {
                        "not": {
                          "required": [
                            "accepted_transport"
                          ]
                        }
                      }
                    },
                    {
                      "if": {
                        "required": [
                          "accepted_transport"
                        ],
                        "properties": {
                          "accepted_transport": {
                            "const": "tcp"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "outcome": {
                            "const": "response"
                          }
                        }
                      }
                    }
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "server",
                    "server_port",
                    "questions"
                  ],
                  "properties": {
                    "server": {
                      "type": "string"
                    },
                    "server_port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "questions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "$ref": "#/$defs/dnsQuestionComplete"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "event",
            "result"
          ]
        }
      ]
    },
    "dnsSuccess": {
      "type": "object",
      "properties": {
        "command": {
          "const": "dns"
        },
        "result": {
          "$ref": "#/$defs/dnsResult"
        }
      },
      "required": [
        "command",
        "result"
      ]
    },
    "dnsUndecoded": {
      "type": "object",
      "required": [
        "attempt",
        "transport",
        "frame"
      ],
      "properties": {
        "attempt": {
          "$ref": "#/$defs/dnsAttemptNumber"
        },
        "transport": {
          "const": "udp"
        },
        "frame": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/frame"
        }
      },
      "additionalProperties": true
    }
  }
}
