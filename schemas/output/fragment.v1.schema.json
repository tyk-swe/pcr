{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:packetcraftr:output:fragment:v1",
  "title": "PacketcraftR fragment output payload v1",
  "description": "Success payload contract for the fragment command. The stable envelope is validated separately.",
  "allOf": [
    {
      "type": "object",
      "required": [
        "command",
        "payload_schema"
      ],
      "properties": {
        "command": {
          "const": "fragment"
        },
        "payload_schema": {
          "const": "packetcraftr.output.fragment/v1"
        }
      }
    },
    {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/aggregateSuccessEnvelope"
            },
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/fragmentSuccess"
                }
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/streamSuccessEnvelope"
            },
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/fragmentStreamSuccess"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "$defs": {
    "fragmentComplete": {
      "type": "object",
      "properties": {
        "mtu": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "fragments": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "bytes": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        }
      },
      "required": [
        "mtu",
        "fragments",
        "bytes"
      ],
      "additionalProperties": true
    },
    "fragmentRecord": {
      "type": "object",
      "properties": {
        "fragment_index": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64"
        },
        "frame": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/frame"
        }
      },
      "required": [
        "fragment_index",
        "frame"
      ],
      "additionalProperties": true
    },
    "fragmentStreamSuccess": {
      "type": "object",
      "properties": {
        "command": {
          "const": "fragment"
        }
      },
      "required": [
        "command",
        "result",
        "event"
      ],
      "oneOf": [
        {
          "properties": {
            "event": {
              "const": "fragment"
            },
            "result": {
              "$ref": "#/$defs/fragmentRecord"
            }
          }
        },
        {
          "properties": {
            "event": {
              "const": "complete"
            },
            "result": {
              "$ref": "#/$defs/fragmentComplete"
            }
          }
        }
      ]
    },
    "fragmentSuccess": {
      "type": "object",
      "properties": {
        "command": {
          "const": "fragment"
        },
        "result": {
          "type": "object",
          "properties": {
            "summary": {
              "$ref": "#/$defs/fragmentComplete"
            },
            "fragments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fragmentRecord"
              }
            }
          },
          "required": [
            "summary",
            "fragments"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "command",
        "result"
      ]
    }
  }
}
