{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:packetcraftr:journal:v1",
  "title": "PacketcraftR engagement journal v1",
  "type": "object",
  "required": [
    "schema",
    "label",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "packetcraftr.journal/v1"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "records": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "command",
          "result_sha256",
          "scope_digest",
          "plan_digest",
          "previous",
          "digest"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "result_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "scope_digest": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          },
          "plan_digest": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          },
          "previous": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
