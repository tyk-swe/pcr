        "updated": "2026-10-09"
      },
      "read_only_review": {
        "reviewed_by": "tyk-swe",
        "reviewed": "2026-10-09",
        "statement": "Sends only HEAD / HTTP/1.0 with no credentials, body, or mutable method; does not follow redirects or authenticate."
      }
    },
