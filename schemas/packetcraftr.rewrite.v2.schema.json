{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tyk-swe/pcr/main/schemas/packetcraftr.rewrite.v2.schema.json",
  "title": "PacketcraftR capture field-assignment rewrite rules v2",
  "type": "object",
  "required": [
    "schema",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "packetcraftr.rewrite/v2"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assign"
        ],
        "properties": {
          "filter": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8192
          },
          "assign": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 8192,
                  "description": "<protocol>[#occurrence].<field>=<value>, decimal or 0x hexadecimal"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "value"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "maxLength": 8192,
                      "description": "Canonical <protocol>[#occurrence].<field> path"
                    },
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
