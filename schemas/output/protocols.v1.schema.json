{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:packetcraftr:output:protocols:v1",
  "title": "PacketcraftR protocols output payload v1",
  "description": "Success payload contract for the protocols command. The stable envelope is validated separately.",
  "allOf": [
    {
      "type": "object",
      "required": [
        "command",
        "payload_schema"
      ],
      "properties": {
        "command": {
          "const": "protocols"
        },
        "payload_schema": {
          "const": "packetcraftr.output.protocols/v1"
        }
      }
    },
    {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "urn:packetcraftr:output:common:v1#/$defs/aggregateSuccessEnvelope"
            },
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/protocolsSuccess"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "$defs": {
    "protocolBinding": {
      "type": "object",
      "required": [
        "parent",
        "discriminator"
      ],
      "properties": {
        "parent": {
          "type": "string",
          "minLength": 1,
          "description": "Protocol whose binding reaches this one during dissection"
        },
        "discriminator": {
          "$ref": "urn:packetcraftr:output:common:v1#/$defs/uint64",
          "description": "Selector value the parent matches: a port, EtherType, or protocol number; zero is the parent's fallback"
        }
      },
      "additionalProperties": true
    },
    "protocolDetail": {
      "type": "object",
      "required": [
        "protocol",
        "aliases",
        "build",
        "dissect",
        "exact_round_trip",
        "matcher",
        "decode_only",
        "fields",
        "bindings",
        "filter_fields"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "build": {
          "type": "boolean"
        },
        "dissect": {
          "type": "boolean"
        },
        "exact_round_trip": {
          "type": "boolean"
        },
        "matcher": {
          "type": "boolean"
        },
        "decode_only": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protocolField"
          }
        },
        "filter_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protocolFilterField"
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protocolBinding"
          }
        },
        "transports": {
          "type": "array",
          "items": {
            "enum": [
              "tcp",
              "udp"
            ]
          }
        },
        "stream_decode": {
          "type": "boolean"
        },
        "coverage": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "protocolDetailResult": {
      "type": "object",
      "required": [
        "protocol"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocolDetail"
        }
      },
      "additionalProperties": true
    },
    "protocolField": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "required",
        "derived",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "bool",
            "unsigned",
            "signed",
            "text",
            "bytes",
            "ipv4",
            "ipv6",
            "mac",
            "list",
            "object",
            "any"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "derived": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protocolField"
          }
        },
        "children_reference": {
          "type": "string",
          "pattern": "^(/children/[0-9]+)*/children$",
          "description": "JSON Pointer to an earlier child array within this top-level field description."
        }
      },
      "additionalProperties": true
    },
    "protocolFilterField": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "fields",
        "description"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "direct",
            "either",
            "bits"
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mask": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "shift": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "bits"
              }
            }
          },
          "then": {
            "required": [
              "mask",
              "shift"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "protocolListResult": {
      "type": "object",
      "required": [
        "protocols"
      ],
      "properties": {
        "protocols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/protocolSummary"
          }
        }
      },
      "additionalProperties": true
    },
    "protocolSummary": {
      "type": "object",
      "required": [
        "protocol",
        "aliases",
        "build",
        "dissect",
        "exact_round_trip",
        "matcher",
        "decode_only"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "build": {
          "type": "boolean"
        },
        "dissect": {
          "type": "boolean"
        },
        "exact_round_trip": {
          "type": "boolean"
        },
        "matcher": {
          "type": "boolean"
        },
        "decode_only": {
          "type": "boolean"
        },
        "transports": {
          "type": "array",
          "items": {
            "enum": [
              "tcp",
              "udp"
            ]
          }
        },
        "stream_decode": {
          "type": "boolean"
        },
        "coverage": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "protocolsResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/protocolListResult"
        },
        {
          "$ref": "#/$defs/protocolDetailResult"
        }
      ]
    },
    "protocolsSuccess": {
      "type": "object",
      "properties": {
        "command": {
          "const": "protocols"
        },
        "result": {
          "$ref": "#/$defs/protocolsResult"
        }
      },
      "required": [
        "command",
        "result"
      ]
    }
  }
}
